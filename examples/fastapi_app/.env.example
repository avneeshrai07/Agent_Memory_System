POSTGRES_DSN=postgresql://user:password@localhost:5432/memory_verse_avneesh

# Required, no default -- a silent "public" default risks colliding with
# another app's tables in the same database.
POSTGRES_SCHEMA=memory_verse_avneesh

# Tier 0/1 cache backend -- set EXACTLY ONE of these two options, not both:

# Option A: standard Redis protocol (self-hosted Redis, ElastiCache, etc.)
REDIS_URL=redis://localhost:6379/0

# Option B: Upstash (REST-based) -- comment out REDIS_URL above if using this
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

AWS_REGION=us-east-1
MEMORY_VERSE_AVNEESH_EMBEDDING_DIM=1024

# AWS credentials for Bedrock. Optional -- omit both to fall back to boto3's
# default chain (~/.aws/credentials, or an instance/task IAM role, the usual
# production pattern). Note the AWS_LLM_ prefix: memory_verse_avneesh reads these
# specific names, not the standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# boto3 auto-discovers, so that Bedrock can use credentials scoped
# separately from anything else in the environment.
# AWS_LLM_ACCESS_KEY_ID=
# AWS_LLM_SECRET_ACCESS_KEY=

# Host-owned generation model choice -- not read by memory_verse_avneesh itself,
# only by this example's own llm.py (see main.py).
CHAT_MODEL_ID=amazon.nova-lite-v1:0
