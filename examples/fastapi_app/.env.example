POSTGRES_DSN=postgresql://user:password@localhost:5432/agent_memory
REDIS_URL=redis://localhost:6379/0
AWS_REGION=us-east-1
AGENT_MEMORY_EMBEDDING_DIM=1024

# AWS credentials: use the standard boto3 resolution chain (env vars below,
# ~/.aws/credentials, or an instance/task role) — agent_memory does not read
# these itself, boto3 does.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
